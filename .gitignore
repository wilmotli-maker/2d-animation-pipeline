.env
node_modules/

# User project data — created by running the pipeline, not part of the tooling.
# Elements, shots, style-locks, and generated artifacts are the user's, per-project.
elements/
shots/

scripts/sanity-checks/state/
scripts/sanity-checks/fixtures/*
!scripts/sanity-checks/fixtures/README.md

# Model weights: whisper.cpp ggml for `voice transcribe`, BiRefNet ONNX for
# `shot matte`. Downloaded on demand, not source — see docs/plans/shot-matte-alpha.md.
models/

# Raw evaluation renders (multi-hundred-MB .mov alpha passes). Only the small
# web/ comparison clips are versioned; the sources stay local.
evaluation/

# Bytecode from the python/ matte sidecar.
__pycache__/

.DS_Store
