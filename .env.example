# Private API keys for the pipeline and its spikes.
#
#   cp .env.example .env      then fill in the values you need.
#
# .env is gitignored and MUST NOT be committed. Anything exported in your shell
# (or injected by CI) overrides the matching line here — shell always wins.
# Add one KEY=value line per provider as you onboard them.

# Runway developer API — video-to-video (Aleph) refinement spike, and any future
# Runway-backed pipeline steps. Get a key + API credits at https://dev.runwayml.com/
RUNWAY_API_KEY=

# Claude / Anthropic (headless/API mode; also read straight from the shell if set).
# ANTHROPIC_API_KEY=

# WaveSpeed — VACE video joiner used by the seedance-stitch skill (~$0.20/join, WaveSpeed
# cash, not Higgsfield/MuAPI credits). Optional. Falls back to ~/.wavespeed/key if unset.
# Get a key at https://wavespeed.ai/
WAVESPEED_API_KEY=

# --- future providers, one per line ---
# SOMEPROVIDER_API_KEY=
